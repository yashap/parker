{
  "name": "parker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:force": "turbo run build --force",
    "clean": "pnpm db:clean && turbo run clean && rm -rf node_modules/",
    "db:clean": "docker rm -f -v parker_postgres_dev parker_postgres_test && docker volume rm -f parker_postgres_data_dev parker_postgres_data_test",
    "db:dump-fixtures": "turbo run db:dump-fixtures",
    "db:migrate-up": "pnpm db:up && turbo run db:migrate-up",
    "db:migrate-up:test": "pnpm db:up:test && turbo run db:migrate-up:test",
    "db:restore-fixtures": "turbo run db:restore-fixtures",
    "db:up": "./tools/scripts/ensure_postgres_up.sh",
    "db:up:test": "./tools/scripts/ensure_postgres_up.sh -p 6441 -c parker_postgres_test -v parker_postgres_data_test",
    "email": "open http://127.0.0.1:4436",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,jsx,json}\" && turbo run format",
    "lint": "prettier --check \"**/*.{ts,tsx,md,js,jsx,json}\" && turbo run lint",
    "serve:backend": "turbo run serve --filter='./backends/*' --parallel",
    "serve:landlord": "pnpm --filter @parker/landlord serve",
    "serve:landlord:web": "pnpm --filter @parker/landlord serve:web",
    "serve:parking": "turbo run serve --filter=@parker/parking",
    "serve:places": "turbo run serve --filter=@parker/places",
    "serve:user": "turbo run serve --filter=@parker/user",
    "sync": "pnpm install && pnpm db:migrate-up && pnpm db:migrate-up:test",
    "test": "turbo run test",
    "test:e2e:web": "pnpm --filter @parker/e2e-tests-web test:e2e",
    "test:force": "turbo run test --force",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.7"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
