{
  "name": "@parker/parking",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf node_modules/ dist/ coverage/ .turbo/ .tsbuildinfo",
    "db:clean": "pnpm db:up && ../../tools/scripts/drop_db.sh parking parker_postgres_dev && ../../tools/scripts/drop_user.sh parking parker_postgres_dev",
    "db:clean:test": "pnpm db:up:test && ../../tools/scripts/drop_db.sh parking parker_postgres_test && ../../tools/scripts/drop_user.sh parking parker_postgres_test",
    "db:dump-fixtures": "../../tools/scripts/dump_fixtures.sh parking",
    "db:generate-custom-migration": "../../tools/scripts/generate_custom_db_migration.sh",
    "db:generate-migration": "pnpm db:up && ../../tools/scripts/generate_db_migration.sh",
    "db:migrate-up": "pnpm db:up && DATABASE_URL='postgresql://dev_admin:dev_admin_password@localhost:6440/parking?schema=public' tsx --conditions=development ./src/db/migrate.ts",
    "db:migrate-up:test": "pnpm db:up:test && DATABASE_URL='postgresql://dev_admin:dev_admin_password@localhost:6441/parking?schema=public' tsx --conditions=development ./src/db/migrate.ts",
    "db:restore-fixtures": "pnpm db:clean && pnpm db:up && ../../tools/scripts/restore_fixtures.sh parking && pnpm db:migrate-up",
    "db:up": "../../tools/scripts/ensure_postgres_db.sh -d parking && ../../tools/scripts/ensure_postgres_user.sh -u parking -w parking_password -d parking",
    "db:up:test": "../../tools/scripts/ensure_postgres_db.sh -d parking -c parker_postgres_test && ../../tools/scripts/ensure_postgres_user.sh -u parking -w parking_password -d parking -c parker_postgres_test",
    "serve": "tsx watch --conditions=development src/main.ts",
    "format": "eslint \"src/**\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@parker/api-client-utils": "workspace:*",
    "@parker/drizzle-utils": "workspace:*",
    "@parker/errors": "workspace:*",
    "@parker/fastify-utils": "workspace:*",
    "@parker/geography": "workspace:*",
    "@parker/logging": "workspace:*",
    "@parker/pagination": "workspace:*",
    "@parker/parking-client": "workspace:*",
    "@parker/time": "workspace:*",
    "@ts-rest/fastify": "^3.52.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.29.1",
    "geo-tz": "^8.1.4",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "supertokens-node": "^23.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@parker/api-client-test-utils": "workspace:*",
    "@parker/eslint-config": "workspace:*",
    "@parker/test-utils": "workspace:*",
    "@parker/tsconfig": "workspace:*",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
