{
  "name": "@parker/e2e-tests-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules/.cache test-results playwright-report .turbo",
    "format": "eslint \"src/**\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**\"",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui"
  },
  "devDependencies": {
    "@parker/eslint-config": "workspace:*",
    "@parker/parking-client": "workspace:*",
    "@parker/tsconfig": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.5",
    "typescript": "~5.9.2"
  }
}
