{
  "name": "@parker/pagination",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf node_modules/ dist/ coverage/ .turbo/ .tsbuildinfo",
    "format": "eslint \"src/**\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@parker/errors": "workspace:*",
    "js-base64": "^3.7.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@parker/eslint-config": "workspace:*",
    "@parker/test-utils": "workspace:*",
    "@parker/tsconfig": "workspace:*",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.5",
    "typescript": "~5.9.2",
    "uuid": "^11.1.0",
    "vitest": "^4.1.10"
  }
}
