{
  "name": "@parker/fastify-utils",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf node_modules/ dist/ coverage/ .turbo/",
    "format": "eslint \"src/**\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**\"",
    "test": "LOG_LEVEL=\"${LOG_LEVEL:-off}\" jest --forceExit --runInBand src/",
    "test:watch": "LOG_LEVEL=\"${LOG_LEVEL:-off}\" jest --forceExit --runInBand --watch src/"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@parker/core": "workspace:*",
    "@parker/correlation-id-propagator": "workspace:*",
    "@parker/errors": "workspace:*",
    "@parker/logging": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "supertokens-node": "^23.1.0",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@parker/api-client-test-utils": "workspace:*",
    "@parker/api-client-utils": "workspace:*",
    "@parker/eslint-config": "workspace:*",
    "@parker/pagination": "workspace:*",
    "@parker/test-utils": "workspace:*",
    "@parker/tsconfig": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.2",
    "uuid": "^11.1.0"
  }
}
