{
  "name": "@parker/fastify-utils",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf node_modules/ dist/ coverage/ .turbo/ .tsbuildinfo",
    "format": "eslint \"src/**\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@parker/core": "workspace:*",
    "@parker/correlation-id-propagator": "workspace:*",
    "@parker/errors": "workspace:*",
    "@parker/logging": "workspace:*",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/fastify": "^3.52.1",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "supertokens-node": "^23.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@parker/api-client-test-utils": "workspace:*",
    "@parker/api-client-utils": "workspace:*",
    "@parker/eslint-config": "workspace:*",
    "@parker/pagination": "workspace:*",
    "@parker/test-utils": "workspace:*",
    "@parker/tsconfig": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "typescript": "~5.9.2",
    "uuid": "^11.1.0",
    "vitest": "^4.1.10"
  }
}
