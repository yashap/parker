{
  "name": "@parker/api-client-test-utils",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf node_modules/ dist/ coverage/ .turbo/ .tsbuildinfo",
    "format": "eslint \"src/**\" --fix",
    "lint": "tsc --noEmit && eslint \"src/**\""
  },
  "dependencies": {
    "@parker/api-client-utils": "workspace:*",
    "@parker/errors": "workspace:*"
  },
  "devDependencies": {
    "@parker/eslint-config": "workspace:*",
    "@parker/test-utils": "workspace:*",
    "@parker/tsconfig": "workspace:*",
    "@types/node": "^24.3.0",
    "eslint": "^9.39.5",
    "fastify": "^4.29.1",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "fastify": "^4.29.1"
  }
}
